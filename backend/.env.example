AUTH_ISSUER=
AUTH_AUDIENCE_NIKNOLIG=
AUTH_AUDIENCE_DEFENSE=
# Absolute host path to existing issuer RSA PUBLIC key, readable by UID 10001.
AUTH_PUBLIC_KEY_FILE=
