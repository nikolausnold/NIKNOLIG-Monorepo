POSTGRES_DB=niknolig_local
POSTGRES_USER=niknolig_local
POSTGRES_PASSWORD=
POSTGRES_PORT=54329
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_API_ENABLED=false
# Existing least-privilege runtime database role; never use POSTGRES_USER here.
BACKEND_DB_USER=
BACKEND_DB_PASSWORD=
