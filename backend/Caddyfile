{
	admin off
	auto_https off
	servers {
		strict_sni_host on
	}
}

https://{$BACKEND_HOSTNAME} {
	tls /run/secrets/tls_certificate /run/secrets/tls_private_key {
		protocols tls1.2 tls1.3
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		Cache-Control "no-store"
		X-Content-Type-Options "nosniff"
		-Server
	}
	request_body {
		max_size 8192
	}
	@health {
		method GET
		path /health/live /health/ready /health /projects /db/health
	}
	handle @health {
		reverse_proxy api:8000 {
			transport http {
				dial_timeout 3s
				response_header_timeout 8s
			}
		}
	}
	@support {
		method POST
		path /support /v1/ai/support
	}
	handle @support {
		reverse_proxy api:8000 {
			transport http {
				dial_timeout 3s
				response_header_timeout 15s
			}
		}
	}
	handle {
		respond 404
	}
}
