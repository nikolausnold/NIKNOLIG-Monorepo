<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background"
    android:fitsSystemWindows="true"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@null"
            android:src="@drawable/support_avatar" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_small"
            android:accessibilityHeading="true"
            android:text="@string/brand_name"
            android:textColor="@color/brand_accent"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium"
            android:accessibilityHeading="true"
            android:text="@string/support_heading"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium"
            android:text="@string/support_flow_description"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />
        <EditText
            android:id="@+id/support_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_large"
            android:autofillHints=""
            android:importantForAutofill="no"
            android:saveEnabled="false"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="500"
            android:minHeight="96dp"
            android:gravity="top|start"
            android:hint="@string/support_question_hint"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />
        <Button
            android:id="@+id/support_answer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_small"
            android:minHeight="48dp"
            android:text="@string/support_answer_button" />
        <TextView
            android:id="@+id/support_answer_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_small"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/card_surface"
            android:padding="@dimen/card_padding"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/support_queue_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_small"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/support_ai_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_large"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/card_surface"
            android:padding="@dimen/card_padding"
            android:text="@string/support_ai_unavailable"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />
        <Button
            android:id="@+id/support_check_ai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium"
            android:minHeight="48dp"
            android:text="@string/support_check_ai" />
        <Button
            android:id="@+id/support_escalate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium"
            android:minHeight="48dp"
            android:text="@string/support_escalate"
            android:visibility="visible" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium"
            android:text="@string/support_payment_notice"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
        <Button
            android:id="@+id/support_mark_sent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium"
            android:minHeight="48dp"
            android:text="@string/support_ticket_mark_sent"
            android:visibility="gone" />
        <Button
            android:id="@+id/support_delete_ticket"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium"
            android:minHeight="48dp"
            android:text="@string/support_ticket_delete"
            android:visibility="gone" />
        <Button
            android:id="@+id/support_close"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_large"
            android:minHeight="48dp"
            android:text="@string/support_close" />
    </LinearLayout>
</ScrollView>
